# Postgres — Neon (neon.tech) или Supabase. Пример Neon:
# postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/filmwishlist?sslmode=require
DATABASE_URL=

# Токен бота из @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# TMDB: themoviedb.org → Settings → API → "API Read Access Token" (v4, длинный, начинается с eyJ...)
TMDB_API_KEY=

# Публичный https-URL мини-аппа (для инвайт-ссылок и настройки в BotFather). При локалке — ngrok URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
